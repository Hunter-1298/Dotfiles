# -----------------------------
# Powerlevel10k instant prompt
# -----------------------------
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# -----------------------------
# Environment variables
# -----------------------------
export HELIX_RUNTIME=~/helix/src/helix/runtime
export PATH="$HOME/.pi/agent/bin:$PATH"
export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH
export PATH=$PATH:/opt/zig
export ZED_ALLOW_EMULATED_GPU=1
export ZSH="$HOME/.oh-my-zsh"
export ZSH_CUSTOM="$ZSH/custom"
export XDG_CONFIG_HOME="$HOME/.config"
export EDITOR=nvim
export VISUAL=nvim

# -----------------------------
# Aliases
# -----------------------------
alias zed="WAYLAND_DISPLAY='' zed"
alias code='cursor'
alias z='zellij'
alias vim=nvim
alias ls='eza --icons --color=always --show-symlinks'
alias lart='eza -als=time --icons --color=always --show-symlinks'
alias la='eza -al --icons --color=always --show-symlinks'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias python3='python'
alias vim='nvim'

# -----------------------------
# History settings
# -----------------------------
HISTSIZE=1000
HISTFILESIZE=2000

# -----------------------------
# Theme and plugins
# -----------------------------
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting virtualenv)

# -----------------------------
# Source Oh My Zsh
# -----------------------------
source $ZSH/oh-my-zsh.sh
# Load Powerlevel10k configuration
# Powerlevel10k configuration
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# -----------------------------
# Optional: cd auto-ls
# -----------------------------
cd() {
    builtin cd "$@" && ls
}
[[ -f ~/.env ]] && source ~/.env

# -----------------------------
# Google Cloud SDK
# -----------------------------
if [ -f '/home/hshayde/google-cloud-sdk/path.zsh.inc' ]; then . '/home/hshayde/google-cloud-sdk/path.zsh.inc'; fi
if [ -f '/home/hshayde/google-cloud-sdk/completion.zsh.inc' ]; then . '/home/hshayde/google-cloud-sdk/completion.zsh.inc'; fi

# -----------------------------
# Extra PATH (npm-global, etc.)
# -----------------------------
export PATH=$PATH:/usr/local/bin
export PATH=$HOME/.npm-global/bin:$PATH
export NVM_DIR="$HOME/.nvm"
# nvm refuses to coexist with a custom npm `prefix` (~/.npm-global) and prints a
# warning on every shell start. Load nvm WITHOUT auto-activating, neutralize its
# prefix check, then activate the default node silently. This keeps ~/.npm-global
# as the global prefix and produces zero console output, so Powerlevel10k's
# instant-prompt warning stays gone too.
if [ -s "$NVM_DIR/nvm.sh" ]; then
  \. "$NVM_DIR/nvm.sh" --no-use
  nvm_die_on_prefix() { :; }
  nvm use default --silent >/dev/null 2>&1
fi

# -----------------------------
# pi worktree shortcut
# -----------------------------
# Pi v0.76+ rejects unknown single-dash flags in its strict CLI parser
# before any extension can intercept, so `pi -w` produces
# 'Error: Unknown option: -w'. Translate it to the long form
# (`pi --worktree`), which the auto-worktree extension registers via
# `pi.registerFlag`. Any other invocation falls through to the real pi.
pi() {
  if [[ "$1" == "-w" ]]; then
    shift
    command pi --worktree "$@"
  else
    command pi "$@"
  fi
}
